# Local mode is self-contained. Azure mode uses managed identity in production.
APP_ENV=development
DEMO_MODE=true
INTERNAL_ACCESS_KEY=change-this-for-a-shared-demo
MAX_UPLOAD_MB=15

# Optional: supply a Fernet key. If omitted in development, one is generated
# under .local-secrets/ with owner-only permissions.
APP_ENCRYPTION_KEY=

# Set STORAGE_BACKEND=azure to store encrypted payloads in a private blob container.
STORAGE_BACKEND=local
AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
AZURE_STORAGE_CONTAINER=cu-content

# Microsoft Foundry hosted agents.
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_CUSTOMER_AGENT_NAME=cu-customer-agent
FOUNDRY_EMPLOYEE_AGENT_NAME=cu-employee-agent

# Foundry Content Understanding.
# Note: the live demo deployment documented in README.md's "Current Azure
# deployment" section still uses its original flv*-prefixed analyzer/agent
# names (from this project's earlier, narrower "First Look Vehicle" scope).
# These example values use the current cu- naming convention for new setups.
CONTENT_UNDERSTANDING_ENDPOINT=https://your-resource.services.ai.azure.com
CONTENT_UNDERSTANDING_IMAGE_ANALYZER_ID=cuVehicleAnalyzer
CONTENT_UNDERSTANDING_DOCUMENT_ANALYZER_ID=cuVehicleDocumentAnalyzer
CONTENT_UNDERSTANDING_API_VERSION=2025-05-01-preview

# Azure AI Document Intelligence.
DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intelligence.cognitiveservices.azure.com
DOCUMENT_INTELLIGENCE_API_VERSION=2023-07-31
